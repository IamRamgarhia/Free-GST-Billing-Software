# ==============================================================================
# Free GST Billing Software - Docker Environment Configuration
# Copy this file to `.env` to customize your deployment.
# ==============================================================================

# Port on the host machine to access the application (Default: 47371)
PORT=47371

# Optional: Allowed CORS origin regex if accessing outside of localhost / 127.0.0.1
# Example for local network: ALLOWED_ORIGINS=^https?://192\.168\.\d+\.\d+(:\d+)?$
# Example to allow any origin: ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=
