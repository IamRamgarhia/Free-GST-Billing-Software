# Shell / macOS launchers MUST have LF endings, otherwise they fail
# with "bad interpreter: /usr/bin/env^M" on macOS and Linux when
# extracted from a Windows-created ZIP.
*.sh          text eol=lf
*.command     text eol=lf
*.bash        text eol=lf

# PowerShell scripts and .bat files can be either but Windows tools
# prefer CRLF — keep them Windows-native.
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# HTA runs via mshta.exe on Windows — CRLF is fine.
*.hta         text eol=crlf
