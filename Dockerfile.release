# Use this Dockerfile from the extracted release directory that contains
# _system/. The release already includes the production frontend in dist/.
FROM node:22-bookworm-slim

WORKDIR /app
COPY _system/ ./

RUN npm ci --no-audit --no-fund

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=47371 \
    DATA_DIR=/app/data

EXPOSE 47371
VOLUME ["/app/data", "/app/Saved Invoices"]
CMD ["node", "server.js"]
